  {
    "id": "utf8Offsets",
    "name": "utf8Offsets",
    "feature": "UTF-8 byte offsets after Russian comment",
    "source": "int utf8Offsets(int n){\n  // Русский комментарий перед циклом\n  int s=0;\n  for(int i=0;i<n;++i){s+=i;}\n  // Возврат результата\n  return s;\n}\n",
    "expect": [
      [
        "s+=i",
        "++i"
      ],
      [
        "++i",
        "i<n"
      ],
      [
        "return s",
        "Конец",
        "return"
      ]
    ],
    "expectedLines": [
      [
        "i<n",
        4
      ],
      [
        "return s",
        6
      ]
    ]
